# Copy this file to `.env` at the worktree root.
# Add your Portkey credentials to `.env`. Do not commit `.env`.
# Set the model, reasoning effort, timeouts, and retries in the prototype's `settings.toml`.

PORTKEY_API_KEY=replace-with-your-portkey-api-key
PORTKEY_VIRTUAL_KEY=replace-with-your-portkey-virtual-key
PORTKEY_BASE_URL=https://your-portkey-gateway.example.com/v1
